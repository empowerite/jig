#!/usr/bin/env bash
# run - runs the controls of one moment, as the manifest in 1st.md names them
#
# `controls/run <moment>`, with the moment one of drafting, admission or sweep. The subject is computed once: the
# staged change on a desk, the pull request's change on a runner, the tree on the sweep. Every control of the
# moment runs and reports; a control whose need refused is skipped and says so; the exit status is non-zero if any
# refused.
set -o errexit -o nounset -o pipefail
here=$(cd "$(dirname "$0")" && pwd)
cd "$(git rev-parse --show-toplevel)"

moment=${1:?usage: controls/run <drafting|admission|sweep>}
case "${moment}" in
  (drafting|admission|sweep) ;;
  (*)
    echo "unknown moment: ${moment}" >&2
    exit 2
esac

# The change, and whether it deletes anything.
changed=()
deleted=false
case "${moment}" in
  (drafting)
    listed=$(git diff --cached --name-only --diff-filter=ACMR)
    while IFS= read -r f
    do
      [[ -n "${f}" ]] && changed+=("${f}")
    done <<< "${listed}"
    if [[ -n "$(git diff --cached --name-only --diff-filter=D)" ]]
    then
      deleted=true
    fi
    ;;
  (admission)
    pr=$(jq --raw-output '.pull_request.number' "${GITHUB_EVENT_PATH}")
    listed=$(gh api "repos/${GITHUB_REPOSITORY}/pulls/${pr}/files" --paginate --jq '.[] | "\(.status)\t\(.filename)"')
    while IFS=$'\t' read -r status f
    do
      if [[ "${status}" == removed ]]
      then
        deleted=true
      elif [[ -n "${f}" ]]
      then
        changed+=("${f}")
      fi
    done <<< "${listed}"
    ;;
esac

# The manifest: one row per control, columns control | moments | subject | needs.
manifest=$(awk -F'|' '
  /^\| [a-z]/ && $2 !~ /control/ {
    for (i = 2; i <= 5; i++) { gsub(/^ +| +$/, "", $i) }
    print $2 "\t" $3 "\t" $4 "\t" $5
  }' "${here}/1st.md")

failed=()
skipped=()
while IFS=$'\t' read -r name moments subject needs
do
  [[ ", ${moments}, " == *", ${moment}, "* ]] || continue
  blocked=""
  for need in ${needs//,/ }
  do
    for f in ${failed[@]+"${failed[@]}"}
    do
      [[ "${need}" == "${f}" ]] && blocked=${need}
    done
  done
  if [[ -n "${blocked}" ]]
  then
    echo "::notice::${name} skipped: it needs ${blocked}, which refused"
    skipped+=("${name}")
    continue
  fi
  args=()
  case "${subject}" in
    ("change, all") args=(--all) ;;
    ("change, changed")
      if [[ "${moment}" == sweep || "${deleted}" == true ]]
      then
        args=(--all)
      else
        args=(--changed ${changed[@]+"${changed[@]}"})
      fi
      ;;
  esac
  echo "==> ${name} ${args[*]:-}"
  if "${here}/${name}" ${args[@]+"${args[@]}"}
  then
    :
  else
    failed+=("${name}")
  fi
done <<< "${manifest}"

if (( ${#failed[@]} > 0 ))
then
  report="refused: ${failed[*]}"
  if (( ${#skipped[@]} > 0 ))
  then
    report="${report}; skipped: ${skipped[*]}"
  fi
  echo "${report}"
  exit 1
fi
echo "every control of ${moment} passed"
